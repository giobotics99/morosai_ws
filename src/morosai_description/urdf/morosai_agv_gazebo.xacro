<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="morosai_agv">
<!-- tags for joints better to insert them in another xml file! here -->

    <gazebo reference="wheel_front_right">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>10000.0</kp>
        <kd>1.0</kd>
        <maxVel>0.5</maxVel>
        <!-- ruota destra: attrito primario “indietro” rispetto all’asse X del link -->
        <fdir1>-1 0 0</fdir1>
    </gazebo>
    
    <gazebo reference="wheel_front_left">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>10000.0</kp>
        <kd>1.0</kd>
        <maxVel>0.5</maxVel>
        <!-- ruota sinistra: attrito primario “in avanti” sull’asse X del link -->
        <fdir1>1 0 0</fdir1>
    </gazebo>
    
    <gazebo reference="wheel_rear_right">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>10000.0</kp>
        <kd>1.0</kd>
        <maxVel>0.5</maxVel>
        <fdir1>-1 0 0</fdir1>
    </gazebo>
    
    <gazebo reference="wheel_rear_left">
        <mu1>3.0</mu1>
        <mu2>3.0</mu2>
        <kp>10000.0</kp>
        <kd>1.0</kd>
        <maxVel>0.5</maxVel>
        <fdir1>1 0 0</fdir1>
    </gazebo>

